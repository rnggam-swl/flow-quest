generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ActivityLog {
  id        String            @id @db.Uuid
  userId    String?           @db.Uuid
  teamId    String?           @db.Uuid
  sessionId String?           @db.Uuid
  metadata  Json?
  createdAt DateTime          @default(now())
  event     ActivityEventType
  Session   Session?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Team      Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User?             @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model AuthSession {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  sessionId  String?  @db.Uuid
  Session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ChatMessage {
  id        String   @id @db.Uuid
  teamId    String   @db.Uuid
  questId   String?  @db.Uuid
  userId    String   @db.Uuid
  text      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  Quest     Quest?   @relation(fields: [questId], references: [id])
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
}

model Constraint {
  id          String            @id @db.Uuid
  questId     String            @db.Uuid
  title       String
  description String
  triggerType ConstraintTrigger @default(MANUAL)
  cost        Int               @default(0)
  Quest       Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
}

model Event {
  id          String @id @db.Uuid
  questId     String @db.Uuid
  title       String
  description String
  eventType   String
  Quest       Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
}

model Feedback {
  id                   String         @id @db.Uuid
  submissionId         String         @db.Uuid
  authorId             String         @db.Uuid
  feedback             String
  visibleToParticipant Boolean        @default(true)
  createdAt            DateTime       @default(now())
  User                 User           @relation(fields: [authorId], references: [id])
  FlowSubmission       FlowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model FlowConnection {
  id                                             String         @id @db.Uuid
  submissionId                                   String         @db.Uuid
  sourceNodeId                                   String         @db.Uuid
  targetNodeId                                   String         @db.Uuid
  connectionType                                 ConnectionType @default(DEFAULT)
  createdBy                                      String         @db.Uuid
  createdAt                                      DateTime       @default(now())
  User                                           User           @relation(fields: [createdBy], references: [id])
  FlowNode_FlowConnection_sourceNodeIdToFlowNode FlowNode       @relation("FlowConnection_sourceNodeIdToFlowNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  FlowSubmission                                 FlowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  FlowNode_FlowConnection_targetNodeIdToFlowNode FlowNode       @relation("FlowConnection_targetNodeIdToFlowNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
}

model FlowNode {
  id                                                   String           @id @db.Uuid
  submissionId                                         String           @db.Uuid
  nodeType                                             NodeType
  label                                                String
  positionX                                            Float
  positionY                                            Float
  createdBy                                            String           @db.Uuid
  createdAt                                            DateTime         @default(now())
  FlowConnection_FlowConnection_sourceNodeIdToFlowNode FlowConnection[] @relation("FlowConnection_sourceNodeIdToFlowNode")
  FlowConnection_FlowConnection_targetNodeIdToFlowNode FlowConnection[] @relation("FlowConnection_targetNodeIdToFlowNode")
  User                                                 User             @relation(fields: [createdBy], references: [id])
  FlowSubmission                                       FlowSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model FlowSubmission {
  id               String           @id @db.Uuid
  teamId           String           @db.Uuid
  questId          String           @db.Uuid
  status           SubmissionStatus @default(DRAFT)
  startedAt        DateTime         @default(now())
  submittedAt      DateTime?
  version          Int              @default(1)
  timeSpentSeconds Int?
  Feedback         Feedback[]
  FlowConnection   FlowConnection[]
  FlowNode         FlowNode[]
  Quest            Quest            @relation(fields: [questId], references: [id])
  Team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Score            Score?

  @@unique([teamId, questId])
}

model InformationCard {
  id               String             @id @db.Uuid
  questId          String             @db.Uuid
  roleId           String?            @db.Uuid
  userId           String?            @db.Uuid
  title            String
  content          String
  type             CardType           @default(EVIDENCE)
  visibility       Visibility         @default(TEAM)
  shareable        Boolean            @default(true)
  cost             Int                @default(0)
  Quest            Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  Role             Role?              @relation(fields: [roleId], references: [id])
  User             User?              @relation(fields: [userId], references: [id])
  InformationShare InformationShare[]

  @@index([questId])
}

model InformationShare {
  id              String          @id @db.Uuid
  informationId   String          @db.Uuid
  sharedBy        String          @db.Uuid
  teamId          String          @db.Uuid
  sharedAt        DateTime        @default(now())
  InformationCard InformationCard @relation(fields: [informationId], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [sharedBy], references: [id])
  Team            Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([informationId, teamId])
}

model Quest {
  id               String            @id @db.Uuid
  scenarioId       String            @db.Uuid
  order            Int
  title            String
  objective        String
  xp               Int               @default(0)
  published        Boolean           @default(false)
  timeLimitMinutes Int?
  ChatMessage      ChatMessage[]
  Constraint       Constraint[]
  Event            Event[]
  FlowSubmission   FlowSubmission[]
  InformationCard  InformationCard[]
  Scenario         Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  SessionQuest     SessionQuest[]
  TeamDecision     TeamDecision[]
  QuestAttempt     QuestAttempt[]

  @@unique([scenarioId, order])
}

model Reflection {
  id        String           @id @db.Uuid
  userId    String           @db.Uuid
  teamId    String           @db.Uuid
  sessionId String           @db.Uuid
  question  String
  answer    String
  createdAt DateTime         @default(now())
  source    ReflectionSource @default(INDIVIDUAL)
  Session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User             @relation(fields: [userId], references: [id])

  @@index([userId, sessionId])
}

model ResourceTransaction {
  id            String   @id @db.Uuid
  teamId        String   @db.Uuid
  amount        Int
  reason        String
  createdAt     DateTime @default(now())
  metadata      Json?
  participantId String?  @db.Uuid
  User          User?    @relation(fields: [participantId], references: [id])
  Team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model Role {
  id              String            @id @db.Uuid
  code            RoleCode          @unique
  label           String
  description     String?
  InformationCard InformationCard[]
  TeamMember      TeamMember[]
}

model Scenario {
  id              String            @id @db.Uuid
  title           String
  description     String
  userDescription String?
  userGoal        String?
  // Slug from the case file (caseContentSchema.key); null for rows this app didn't create from one.
  key             String?           @unique
  Quest           Quest[]
  ScenarioVersion ScenarioVersion[]
}

// A snapshot of one case's content — the whole caseContentSchema document from
// src/lib/content/case.ts (node library, quests and their questions, Modul Latihan modules).
// Each Session pins the version it runs, so editing or re-importing a case never changes a
// session that has already started.
model ScenarioVersion {
  id          String        @id @db.Uuid
  scenarioId  String        @db.Uuid
  version     Int
  status      ContentStatus @default(DRAFT)
  content     Json
  note        String?
  createdBy   String?       @db.Uuid
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
  Scenario    Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  User        User?         @relation(fields: [createdBy], references: [id])
  Session     Session[]

  @@unique([scenarioId, version])
}

model Score {
  id              String         @id @db.Uuid
  submissionId    String         @unique @db.Uuid
  goalScore       Float          @default(0)
  flowScore       Float          @default(0)
  logicScore      Float          @default(0)
  constraintScore Float          @default(0)
  edgeCaseScore   Float          @default(0)
  simplicityScore Float          @default(0)
  rationaleScore  Float          @default(0)
  totalScore      Float          @default(0)
  reviewedBy      String?        @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  User            User?          @relation(fields: [reviewedBy], references: [id])
  FlowSubmission  FlowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Session {
  id                 String               @id @db.Uuid
  title              String
  description        String?
  sessionCode        String               @unique
  status             SessionStatus        @default(DRAFT)
  startAt            DateTime?
  endAt              DateTime?
  timeLimitMinutes   Int?
  createdBy          String               @db.Uuid
  createdAt          DateTime             @default(now())
  ActivityLog        ActivityLog[]
  AuthSession        AuthSession[]
  Reflection         Reflection[]
  SessionParticipant SessionParticipant[]
  SessionQuest       SessionQuest[]
  Team               Team[]
  // The case content this session runs (null only for sessions of cases that predate versioning).
  scenarioVersionId  String?              @db.Uuid
  ScenarioVersion    ScenarioVersion?     @relation(fields: [scenarioVersionId], references: [id])
}

model SessionParticipant {
  id            String            @id @db.Uuid
  sessionId     String            @db.Uuid
  participantId String            @db.Uuid
  startedAt     DateTime?
  deadlineAt    DateTime?
  completedAt   DateTime?
  totalXp       Int               @default(0)
  createdAt     DateTime          @default(now())
  status        ParticipantStatus @default(REGISTERED)
  User          User              @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Session       Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  PracticePlan  PracticePlan?
  QuestAttempt  QuestAttempt[]

  @@unique([sessionId, participantId])
  @@index([sessionId, status])
}

// One participant's run at one quest — timing and status for every quest type. A flow
// question's canvas still lives in FlowSubmission (per solo team, scored into Score); quiz
// answers hang off the attempt as QuestionResponse rows.
model QuestAttempt {
  id                   String             @id @db.Uuid
  sessionParticipantId String             @db.Uuid
  questId              String             @db.Uuid
  status               SubmissionStatus   @default(DRAFT)
  startedAt            DateTime           @default(now())
  submittedAt          DateTime?
  timeSpentSeconds     Int?
  SessionParticipant   SessionParticipant @relation(fields: [sessionParticipantId], references: [id], onDelete: Cascade)
  Quest                Quest              @relation(fields: [questId], references: [id])
  QuestionResponse     QuestionResponse[]

  @@unique([sessionParticipantId, questId])
}

// A participant's answer to one quiz question (questionKey = the question's `id` in the
// pinned case content), with its score as { correct, total } from scoreQuestion.
model QuestionResponse {
  id           String       @id @db.Uuid
  attemptId    String       @db.Uuid
  questionKey  String
  answer       Json
  correct      Float
  total        Float
  answeredAt   DateTime     @default(now())
  QuestAttempt QuestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionKey])
}

// Modul Latihan Flow — the follow-up a participant opens after finishing all five quests.
// `content` is the mentor-authored plan (greeting name, strengths, which core modules, and a
// "latihan utama" rebuilt from their own quest answers), validated by practicePlanContentSchema
// in src/lib/practice/plan.ts; null means no personal plan yet, so they get all six modules.
// `completedParts` holds finished module keys ("A".."F") plus "main"; `answers` maps a write
// widget's key (see answerKey) to the text the participant saved.
model PracticePlan {
  id                   String             @id @db.Uuid
  sessionParticipantId String             @unique @db.Uuid
  content              Json?
  completedParts       String[]           @default([])
  answers              Json               @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  SessionParticipant   SessionParticipant @relation(fields: [sessionParticipantId], references: [id], onDelete: Cascade)
}

model SessionQuest {
  id               String  @id @db.Uuid
  sessionId        String  @db.Uuid
  questId          String  @db.Uuid
  order            Int
  // This session's timer for the quest, overriding the pinned content's timeLimitMinutes
  // (null: use the content's; 0: no timer).
  timeLimitMinutes Int?
  Quest            Quest   @relation(fields: [questId], references: [id])
  Session          Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@unique([sessionId, questId])
  @@index([sessionId, order])
}

model Team {
  id                  String                @id @db.Uuid
  sessionId           String                @db.Uuid
  name                String
  resourcePoints      Int                   @default(0)
  createdAt           DateTime              @default(now())
  // Set only for this app's solo-play teams (see ensureSoloTeam) — the (sessionId, soloOwnerId)
  // unique constraint is what makes "get or create this user's solo team" a safe atomic upsert
  // instead of a racy check-then-create.
  soloOwnerId         String?               @db.Uuid
  ActivityLog         ActivityLog[]
  ChatMessage         ChatMessage[]
  FlowSubmission      FlowSubmission[]
  InformationShare    InformationShare[]
  Reflection          Reflection[]
  ResourceTransaction ResourceTransaction[]
  Session             Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  TeamDecision        TeamDecision[]
  TeamMember          TeamMember[]

  @@unique([sessionId, soloOwnerId])
  @@index([sessionId])
}

model TeamDecision {
  id             String    @id @db.Uuid
  teamId         String    @db.Uuid
  questId        String    @db.Uuid
  question       String
  options        Json
  selectedOption String?
  decidedAt      DateTime?
  Quest          Quest     @relation(fields: [questId], references: [id])
  Team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Vote           Vote[]
}

model TeamMember {
  id       String   @id @db.Uuid
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  roleId   String   @db.Uuid
  joinedAt DateTime @default(now())
  Role     Role     @relation(fields: [roleId], references: [id])
  Team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id                  String                @id @db.Uuid
  email               String                @unique
  displayName         String
  passwordHash        String?
  appRole             AppRole               @default(PARTICIPANT)
  avatarUrl           String?
  school              String?
  groupName           String?
  flowViewMode        FlowViewMode          @default(HORIZONTAL)
  createdAt           DateTime              @default(now())
  ActivityLog         ActivityLog[]
  AuthSession         AuthSession[]
  ChatMessage         ChatMessage[]
  Feedback            Feedback[]
  FlowConnection      FlowConnection[]
  FlowNode            FlowNode[]
  InformationCard     InformationCard[]
  InformationShare    InformationShare[]
  Reflection          Reflection[]
  ResourceTransaction ResourceTransaction[]
  Score               Score[]
  SessionParticipant  SessionParticipant[]
  TeamMember          TeamMember[]
  Vote                Vote[]
  ScenarioVersion     ScenarioVersion[]
}

model Vote {
  id             String       @id @db.Uuid
  decisionId     String       @db.Uuid
  userId         String       @db.Uuid
  selectedOption String
  createdAt      DateTime     @default(now())
  TeamDecision   TeamDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id])

  @@unique([decisionId, userId])
}

enum ActivityEventType {
  SESSION_JOINED
  QUEST_STARTED
  QUEST_COMPLETED
  INFORMATION_VIEWED
  INFORMATION_SHARED
  CARD_SHARED
  NODE_CREATED
  NODE_UPDATED
  NODE_DELETED
  NODE_CONNECTED
  NODE_DISCONNECTED
  FLOW_VALIDATED
  VALIDATION_FAILED
  DECISION_CREATED
  VOTE_CAST
  CONSTRAINT_REVEALED
  EVENT_TRIGGERED
  RESOURCE_SPENT
  FLOW_SUBMITTED
  REFLECTION_SUBMITTED
  TEAM_MESSAGE
  FOCUS_LOST
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppRole {
  ADMIN
  PARTICIPANT
}

enum CardType {
  EVIDENCE
  HINT
  REQUIREMENT
}

enum ConnectionType {
  DEFAULT
  YES
  NO
  RECOVERY
}

enum ConstraintTrigger {
  TIME
  MANUAL
  QUEST_COMPLETE
  RANDOM
}

enum FlowViewMode {
  VERTICAL
  HORIZONTAL
}

enum NodeType {
  START
  ACTION
  SCREEN
  SYSTEM
  DECISION
  OUTCOME
  ERROR
}

enum ParticipantStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
  TIME_EXPIRED
  ABANDONED
}

enum ReflectionSource {
  TEAM
  INDIVIDUAL
}

enum RoleCode {
  EXPLORER
  STRATEGIST
  ARCHITECT
  COORDINATOR
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  TIME_EXPIRED
  REVIEWED
}

enum Visibility {
  TEAM
  ROLE
  USER
}
